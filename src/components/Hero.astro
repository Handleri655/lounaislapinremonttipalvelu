---
import { getImage } from "astro:assets";
import heroSrc from "../assets/meista-tyomaa.jpg";
import { site, trustItems } from "../data/site";

const hero = await getImage({ src: heroSrc, format: "webp", width: 1920, quality: 72 });
const heroSmall = await getImage({ src: heroSrc, format: "webp", width: 900, quality: 68 });
---

<section class="relative isolate overflow-hidden bg-ink text-paper">
  <img
    src={hero.src}
    srcset={`${heroSmall.src} 900w, ${hero.src} 1920w`}
    sizes="100vw"
    width={hero.attributes.width}
    height={hero.attributes.height}
    alt="Kuvituskuva hitsaustyöstä"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[center_42%]"
    fetchpriority="high"
    decoding="async"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-ink via-ink/85 to-ink/35"></div>
  <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink/80 via-transparent to-ink/40"></div>

  <div class="mx-auto flex min-h-[34rem] max-w-7xl flex-col justify-center px-5 py-16 sm:min-h-[40rem] sm:px-8 lg:min-h-[calc(100svh-5rem)]">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.28em] text-safety">
      Kemi · Tornio · Lappi · vuodesta {site.founded}
    </p>
    <h1 class="mt-4 max-w-4xl font-display text-5xl font-bold uppercase leading-[0.92] text-white sm:text-7xl lg:text-8xl">
      Rakentaminen, kunnossapito ja autohuolto <span class="text-safety">Kemistä</span>
    </h1>
    <p class="mt-6 max-w-xl text-lg leading-relaxed text-paper/90">
      Luotettavaa ammattitaitoa Lapista Huippuvuorille asti. Tomi Dianoffin yritys tekee työn asiakkaan tarpeen mukaan, lähellä ja kauempana.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href="/#yhteystiedot"
        class="inline-flex min-h-12 items-center justify-center rounded-md bg-safety-deep px-6 text-base font-semibold text-white hover:bg-safety-dark"
      >
        Pyydä tarjous
      </a>
      <a
        href={`tel:${site.phoneTel}`}
        class="inline-flex min-h-12 items-center justify-center rounded-md border border-white/40 px-6 text-base font-semibold text-white hover:border-white hover:bg-white/10"
      >
        Soita {site.phoneDisplay}
      </a>
    </div>

    <dl class="mt-12 grid max-w-4xl grid-cols-2 gap-px overflow-hidden rounded-md border border-white/15 bg-white/15 sm:grid-cols-4">
      {
        trustItems.map((item) => (
          <div class="bg-ink/75 px-4 py-4 backdrop-blur-sm">
            <dt class="text-xs font-medium uppercase tracking-[0.16em] text-paper/65">{item.label}</dt>
            <dd class="mt-1 font-display text-xl font-bold uppercase leading-none text-white sm:text-2xl">{item.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
