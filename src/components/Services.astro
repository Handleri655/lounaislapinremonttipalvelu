---
import { getImage } from "astro:assets";
import rakentaminenSrc from "../assets/rakentaminen.jpg";
import autohuoltoSrc from "../assets/autohuolto.jpg";
import Icon from "./Icon.astro";
import { services } from "../data/services";

const images = {
  rakentaminen: await getImage({ src: rakentaminenSrc, format: "webp", width: 1400, quality: 72 }),
  autohuolto: await getImage({ src: autohuoltoSrc, format: "webp", width: 1400, quality: 72 }),
};

const featured = services.filter((service) => service.layout === "feature");
const cards = services.filter((service) => service.layout === "card");
const wide = services.find((service) => service.layout === "wide");
---

<section id="palvelut" class="reveal bg-paper py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.24em] text-safety-deep">01 — Palvelut</p>
    <div class="mt-3 flex flex-col justify-between gap-4 md:flex-row md:items-end">
      <h2 class="max-w-xl font-display text-4xl font-bold uppercase leading-none text-ink sm:text-6xl">
        Tekijä rakentamiseen, halliin ja laitokseen
      </h2>
      <p class="max-w-md text-base leading-relaxed text-muted">
        Sama yritys hoitaa remontin, teollisuuden kunnossapidon ja auton huollon. Työ tehdään Kemistä käsin, myös Tornioon, Keminmaalle ja kauemmas.
      </p>
    </div>

    <div class="mt-10 grid gap-4 lg:grid-cols-2">
      {
        featured.map((service) => {
          const image = service.image ? images[service.image] : undefined;
          return (
            <article class="group relative min-h-80 overflow-hidden rounded-md bg-ink">
              {image && (
                <img
                  src={image.src}
                  width={image.attributes.width}
                  height={image.attributes.height}
                  alt=""
                  class="absolute inset-0 h-full w-full object-cover"
                />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/55 to-ink/10"></div>
              <div class="relative flex h-full min-h-80 flex-col justify-end p-6 sm:p-8">
                <span class="grid size-11 place-items-center rounded-md bg-safety text-ink">
                  <Icon name={service.icon} class="size-6" />
                </span>
                <h3 class="mt-4 font-display text-4xl font-bold uppercase leading-none text-white">{service.title}</h3>
                <p class="mt-3 max-w-md text-paper/90">{service.text}</p>
              </div>
            </article>
          );
        })
      }
    </div>

    <ul class="mt-4 grid gap-4 sm:grid-cols-2">
      {
        cards.map((service) => (
          <li class="rounded-md border border-line bg-white p-6">
            <span class="grid size-11 place-items-center rounded-md bg-paper-2 text-safety-deep">
              <Icon name={service.icon} class="size-6" />
            </span>
            <h3 class="mt-4 font-display text-3xl font-bold uppercase leading-none">{service.title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{service.text}</p>
          </li>
        ))
      }
    </ul>

    {
      wide && (
        <article class="mt-4 rounded-md bg-ink px-6 py-8 text-paper sm:px-8">
          <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
            <div class="max-w-xl">
              <span class="grid size-11 place-items-center rounded-md bg-safety text-ink">
                <Icon name={wide.icon} class="size-6" />
              </span>
              <h3 class="mt-4 font-display text-4xl font-bold uppercase leading-none text-white">{wide.title}</h3>
              <p class="mt-3 text-paper/80">{wide.text}</p>
            </div>
            <ul class="flex flex-wrap gap-2 lg:max-w-xl lg:justify-end">
              {wide.tags?.map((tag) => (
                <li class="rounded-full border border-white/20 px-3 py-1.5 text-sm text-paper">{tag}</li>
              ))}
            </ul>
          </div>
        </article>
      )
    }
  </div>
</section>
