---
import Icon from "./Icon.astro";
import { reviews } from "../data/reviews";
import { site } from "../data/site";

const rating = site.rating.toFixed(1).replace(".", ",");
---

<section id="arvostelut" class="reveal bg-paper py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.24em] text-safety-deep">03 — Arvostelut</p>
    <div class="mt-3 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <h2 class="font-display text-4xl font-bold uppercase leading-none sm:text-6xl">Asiakkaat palaavat samaan halliin</h2>
        <p class="mt-4 max-w-xl text-muted">
          Google-arvosana <strong class="font-semibold text-ink">{rating} / 5</strong> perustuu {site.reviewCount} julkiseen arvosteluun.
          Alla otteita, joissa kiitetään nopeutta, renkaita, jarruja ja öljynvaihtoja.
        </p>
      </div>
      <p class="font-display text-7xl font-bold leading-none text-ink" aria-hidden="true">
        {rating}
        <span class="ml-1 text-3xl text-safety">★★★★★</span>
      </p>
    </div>

    <ul class="mt-10 flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 lg:grid lg:grid-cols-3 lg:overflow-visible">
      {
        reviews.map((review) => (
          <li class="flex w-[min(100%,22rem)] shrink-0 snap-start flex-col rounded-md border border-line bg-white p-6 lg:w-auto">
            <p class="text-safety" aria-label={`${review.stars} tähteä viidestä`}>
              <span aria-hidden="true" class="inline-flex gap-0.5">
                {Array.from({ length: review.stars }).map(() => (
                  <Icon name="star" class="size-4" />
                ))}
              </span>
            </p>
            <blockquote class="mt-4 flex-1 text-base leading-relaxed text-ink">“{review.quote}”</blockquote>
            <footer class="mt-6 flex items-center justify-between gap-3 text-sm">
              <span class="font-semibold">{review.name}</span>
              <span class="text-muted">{review.source}</span>
            </footer>
          </li>
        ))
      }
    </ul>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a
        href={site.googleMapsUrl}
        class="inline-flex min-h-12 items-center justify-center rounded-md bg-ink px-5 font-semibold text-white hover:bg-ink-soft"
        target="_blank"
        rel="noopener noreferrer"
      >
        Lue arvostelut Googlessa
      </a>
      <a
        href={site.googleWriteReviewUrl}
        class="inline-flex min-h-12 items-center justify-center rounded-md border border-ink/20 px-5 font-semibold text-ink hover:border-ink"
        target="_blank"
        rel="noopener noreferrer"
      >
        Jätä arvostelu
      </a>
    </div>
  </div>
</section>
