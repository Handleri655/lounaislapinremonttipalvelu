---
import Icon from "./Icon.astro";
import { site } from "../data/site";

const pluginSrc = `https://www.facebook.com/plugins/page.php?href=${encodeURIComponent(site.facebook)}&tabs=timeline&width=500&height=560&small_header=false&adapt_container_width=true&hide_cover=false&show_facepile=false&locale=fi_FI`;
---

<section class="reveal bg-ink py-16 text-paper" aria-labelledby="facebook-otsikko">
  <div class="mx-auto grid max-w-7xl items-center gap-8 px-5 sm:px-8 lg:grid-cols-2">
    <div>
      <p class="font-display text-sm font-semibold uppercase tracking-[0.24em] text-safety">05 — Facebook</p>
      <h2 id="facebook-otsikko" class="mt-3 font-display text-4xl font-bold uppercase leading-none text-white sm:text-5xl">
        Seuraa työmaita ja hallin arkea
      </h2>
      <p class="mt-4 max-w-lg text-paper/75">
        Kuvat ja kuulumiset päivittyvät yrityksen Facebook-sivulle. Syöte ladataan tälle sivulle vasta, kun sitä pyydetään.
      </p>
      <a
        href={site.facebook}
        class="mt-6 inline-flex min-h-12 items-center gap-2 rounded-md bg-safety-deep px-5 font-semibold text-white hover:bg-safety-dark"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="facebook" class="size-5" />
        Avaa Facebook
      </a>
    </div>
    <div data-facebook-slot class="rounded-md border border-white/15 bg-ink-soft p-6">
      <p class="text-sm leading-relaxed text-paper/75">
        Facebookin upotus voi asettaa evästeitä. Siksi syöte ei lataudu itsestään.
      </p>
      <button
        type="button"
        data-facebook-load
        data-src={pluginSrc}
        class="mt-4 inline-flex min-h-11 items-center rounded-md border border-white/30 px-4 font-semibold text-white hover:border-white"
      >
        Näytä Facebook-syöte
      </button>
    </div>
  </div>
</section>

<script>
  const button = document.querySelector("[data-facebook-load]");
  const slot = document.querySelector("[data-facebook-slot]");
  if (button instanceof HTMLButtonElement && slot instanceof HTMLElement) {
    button.addEventListener("click", () => {
      const src = button.dataset.src;
      if (!src) return;
      const frame = document.createElement("iframe");
      frame.src = src;
      frame.title = "Lounais-Lapin Remonttipalvelu Facebookissa";
      frame.loading = "lazy";
      frame.className = "h-[560px] w-full rounded-md border-0 bg-white";
      frame.setAttribute("referrerpolicy", "no-referrer-when-downgrade");
      slot.replaceChildren(frame);
    });
  }
</script>
