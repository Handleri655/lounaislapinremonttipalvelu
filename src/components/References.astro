---
import { references } from "../data/site";
---

<section id="referenssit" class="reveal border-y border-line bg-white py-14" aria-label="Asiakkaita">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <p class="font-display text-sm font-semibold uppercase tracking-[0.24em] text-safety-deep">04 — Asiakkaita</p>
    <h2 class="mt-3 font-display text-3xl font-bold uppercase leading-none sm:text-5xl">Töitä yrityksille ja taloyhtiöille</h2>
    <ul class="mt-8 flex flex-wrap gap-3">
      {
        references.map((name) => (
          <li class="rounded-full border border-line bg-paper px-4 py-2 text-sm font-semibold tracking-wide text-ink/80">
            {name}
          </li>
        ))
      }
    </ul>
  </div>
</section>
