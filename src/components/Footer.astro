---
import Icon from "./Icon.astro";
import { nav, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="bg-ink pb-8 pt-14 text-paper">
  <div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 md:grid-cols-3">
    <div>
      <p class="font-display text-3xl font-bold uppercase leading-none text-white">{site.shortName}</p>
      <p class="mt-3 text-sm text-paper/70">Y-tunnus {site.businessId}</p>
      <p class="mt-1 text-sm text-paper/70">Kemi</p>
    </div>
    <nav aria-label="Alatunniste">
      <ul class="space-y-2 text-sm">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-paper/80 hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/tietosuoja" class="text-paper/80 hover:text-white">Tietosuojaseloste</a>
        </li>
      </ul>
    </nav>
    <div class="text-sm">
      <p>
        <a href={`tel:${site.phoneTel}`} class="font-semibold text-white hover:text-safety">{site.phoneDisplay}</a>
      </p>
      <p class="mt-1">
        <a href={`mailto:${site.email}`} class="break-all text-paper/80 hover:text-white">{site.email}</a>
      </p>
      <p class="mt-4 flex flex-wrap items-center gap-4">
        <a href={site.facebook} class="inline-flex items-center gap-2 text-paper/80 hover:text-white" target="_blank" rel="noopener noreferrer">
          <Icon name="facebook" class="size-4" />
          Facebook
        </a>
        <a href={site.luotettavaKumppani} class="inline-flex items-center gap-2 text-paper/80 hover:text-white" target="_blank" rel="noopener noreferrer">
          <Icon name="shield" class="size-4" />
          Luotettava kumppani
        </a>
      </p>
    </div>
  </div>
  <p class="mx-auto mt-10 max-w-7xl px-5 text-xs text-paper/50 sm:px-8">© {year} {site.name}</p>
</footer>
