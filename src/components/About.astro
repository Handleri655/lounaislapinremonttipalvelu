---
import { getImage } from "astro:assets";
import aboutSrc from "../assets/rakentaminen.jpg";
import { site } from "../data/site";

const about = await getImage({ src: aboutSrc, format: "webp", width: 1400, quality: 72 });
---

<section id="meista" class="reveal bg-paper-2 py-20 sm:py-24">
  <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 sm:px-8 lg:grid-cols-2 lg:gap-16">
    <div class="relative">
      <img
        src={about.src}
        width={about.attributes.width}
        height={about.attributes.height}
        alt="Kuvituskuva rakennustyömaalta"
        class="aspect-[4/5] w-full rounded-md object-cover object-[center_75%] sm:aspect-[5/4] lg:aspect-[4/5]"
        loading="lazy"
      />
    </div>

    <div>
      <p class="font-display text-sm font-semibold uppercase tracking-[0.24em] text-safety-deep">02 — Meistä</p>
      <h2 class="mt-3 font-display text-4xl font-bold uppercase leading-none sm:text-6xl">
        Hallista laitokseen, Kemistä Huippuvuorille
      </h2>
      <div class="mt-6 space-y-4 text-base leading-relaxed text-muted">
        <p>
          Perustin {site.name}:n vuonna {site.founded}. Rakentamisen kokemusta on kertynyt vuodesta {site.experienceSince}:
          laitosmiehenä Kemin Veitsiluodossa, sen jälkeen tuotantolaitoksilla ja kaivoksilla.
        </p>
        <p>
          Töitä on ollut myös Ruotsissa ja Norjassa, rakennustyömailla Etelä- ja Pohjois-Suomessa sekä maanrakennus- ja putkitöissä Norjan Huippuvuorille asti.
        </p>
      </div>
      <blockquote class="mt-8 border-l-4 border-safety pl-5">
        <p class="text-lg leading-relaxed text-ink">
          Lounais-Lapin Remonttipalvelun kautta haluan tuoda luotettavaa ja ammattitaitoista palvelua lähi-alueelle ja kauemmas, juuri asiakkaan tarpeisiin.
        </p>
        <footer class="mt-3 text-sm font-medium text-muted">
          {site.owner}, {site.ownerTitle.toLowerCase()}
          <span class="mt-1 block">{site.ownerRole}</span>
        </footer>
      </blockquote>
      <p class="mt-6 text-sm leading-relaxed text-muted">
        Yritys kuuluu
        <a href={site.luotettavaKumppani} class="font-semibold text-safety-deep underline underline-offset-2" target="_blank" rel="noopener noreferrer">
          Luotettava kumppani
        </a>
        -palveluun. Työlle annetaan 12 kuukauden takuu. Palvelemme suomeksi, englanniksi, venäjäksi ja ukrainaksi.
      </p>
    </div>
  </div>
</section>
